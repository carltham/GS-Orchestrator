{
  "name": "@gs/process-server",
  "version": "1.0.0",
  "description": "Standalone process server engine for GS-Orchestrator running on port 9999",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && mkdir -p dist/templates && cp src/templates/* dist/templates/",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts"
  },
  "dependencies": {
    "@gs/process-client": "http://localhost:9999/packages/process-client.tgz",
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^20.5.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}
