{
  "name": "gs-orchestrator-tests",
  "version": "1.0.0",
  "description": "Consolidated testing package for SFT, SIT, and UIT suites",
  "scripts": {
    "test:sft": "jest --config jest.config.js --testMatch '**/or/sft/**/*.test.ts' --runInBand --passWithNoTests",
    "test:sit": "jest --config jest.config.js --testMatch '**/ps/sit/**/*.test.ts' '**/sys/sit/**/*.test.ts' --runInBand --passWithNoTests"
  },
  "dependencies": {
    "@gs/process-client": "http://localhost:9999/packages/process-client.tgz",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/supertest": "^2.0.16",
    "jest": "^29.5.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  }
}
