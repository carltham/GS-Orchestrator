{
  "name": "gs-orchestrator",
  "version": "1.0.0",
  "description": "Centralized orchestrator for managing 14 projects - handles port allocation, service discovery, and project status",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --testMatch='**/tests/**/*IT.ts'",
    "startupHandler": "node startupHandler.js"
  },
  "dependencies": {
    "@gs/orchestrator-client": "file:../lib/orchestrator-client",
    "express": "^4.18.2",
    "gs-orchestrator": "file:",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^2.0.12",
    "jest": "^29.5.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1"
  }
}