  "main": "startupHandler.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "dev": "npm --prefix GS-Orchestrator run dev",
    "build": "npm --prefix GS-Orchestrator run build && npm --prefix lib/process-client run build",
    "start": "node node_modules/@gs/process-client/dist/index.js",
    "test": "npm --prefix GS-Orchestrator test",
    "test:sft": "npm --prefix testing run test:sft",
    "test:sit": "npm --prefix testing run test:sit",
    "test:uit": "npm --prefix testing/playwright run test:uit",
    "test:all": "ts-node --project testing/tsconfig.json testing/src/run-all-tests.ts",
    "startupHandler": "node startupHandler.js"
  },
  "repository": {
    "type": "git",
