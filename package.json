{
  "name": "gs-orchestrator",
  "version": "1.0.0",
  "description": "",
  "main": "GS-Orchestrator/dist/server.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "server": "npm --prefix lib/process-server run dev",
    "server:start": "mkdir -p logs && nohup npm --prefix lib/process-server run dev > logs/process-server.log 2>&1 &",
    "server:stop": "fuser -k 9999/tcp 2>/dev/null || true",
    "dev": "npm --prefix GS-Orchestrator run dev",
    "build": "npm --prefix GS-Orchestrator run build && npm --prefix lib/process-client run build",
    "start": "node node_modules/@gs/process-client/dist/index.js",
    "test": "npm --prefix GS-Orchestrator test",
    "test:sft": "npm --prefix testing run test:sft",
    "test:sit": "npm --prefix testing run test:sit",
    "test:uit": "npm --prefix testing/playwright run test:uit",
    "test:all": "testing/node_modules/.bin/ts-node --project testing/tsconfig.json testing/src/run-all-tests.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carltham/GS-Orchestrator.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/carltham/GS-Orchestrator/issues"
  },
  "homepage": "https://github.com/carltham/GS-Orchestrator#readme",
  "dependencies": {
    "@gs/process-client": "http://localhost:9999/packages/process-client.tgz"
  }
}
